# 自定义固件配置（config_file 用的就是这种文件）
#
# 用法：
#   1. 把这个文件提交到你的 fork，例如放到 configs/tyfza1-custom.config
#   2. Actions → Build TYFZA1 firmware → Run workflow
#        release_tag = 一个全新的 v 开头的名字（如 v0.9.0-my）
#        config_file = configs/custom.config
#
# 内容约定：
#   - 这不是插件源码，也不是 .apk 文件，只是"哪些包编进固件"的编译配置
#   - 请以 port/configs/tyfza1-boot.config 为底稿复制，再在下面追加你要的包
#     （底稿里的 CONFIG_TARGET_* 不能删，否则 make defconfig 选不出目标板）
#   - 每行一个 CONFIG_PACKAGE_<包名>=y；依赖会自动带上，不用手写
#   - 包名必须和 feed 里的完全一致，写错的包会被 make defconfig 静默丢弃，
#     build.sh 只校验少数几个必需包，不会提示你写错了
#   - 下面这些行不要改，构建时会被自动覆盖：
#       CONFIG_VERSIONOPT / CONFIG_VERSION_NUMBER / CONFIG_VERSION_REPO
#       CONFIG_SIGNED_PACKAGES / CONFIG_SIGN_EACH_PACKAGE
#   - port/configs/tyfza1-compat.config 里的包会被强制追加，删不掉
#   - rootfs 上限 33648640 字节（约 32.09 MiB），加多了会在 image 阶段失败

# ==== 目标板（必须保留，来自 tyfza1-boot.config）====
CONFIG_TARGET_rtl9617c=y
CONFIG_TARGET_rtl9617c_generic=y
CONFIG_TARGET_rtl9617c_generic_DEVICE_tianyi_tyfza1=y
CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_TARGET_INITRAMFS_COMPRESSION_GZIP=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_TARGZ=y

# ==== WireGuard（官方 luci feed，已确认存在于锁定的 commit）====
CONFIG_PACKAGE_luci-proto-wireguard=y
# wireguard-tools 通常会自己带上内核模块，写死一行更保险，体积很小
CONFIG_PACKAGE_kmod-wireguard=y

# ==== 第三方插件 ====
# 注意：这两个包名必须能在 feed 里找到，否则 make defconfig 会静默丢弃，
# 构建脚本不会提示。加完后建议本机跑一次
#   ./scripts/feeds list -n | grep -E 'ssr|mosdns'
# 或直接看上游仓库目录确认包名。

# fw876/helloworld
CONFIG_PACKAGE_luci-app-ssr-plus=y
CONFIG_PACKAGE_luci-app-ssr-plus_Nftables_Transparent_Proxy=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_NONE_V2RAY=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Xray=y



#其它插件
CONFIG_PACKAGE_luci-app-rtp2httpd=y
CONFIG_PACKAGE_luci-theme-aurora=y
CONFIG_PACKAGE_luci-app-aurora-config=y
# ssr-plus 是 Lua/CBI 应用，需要 luci-compat 才能在 JS 版 LuCI 下正常显示
CONFIG_PACKAGE_luci-compat=y
#luci基础
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_rpcd=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn=y

# sbwml/luci-app-mosdns
CONFIG_PACKAGE_luci-app-mosdns=y
CONFIG_PACKAGE_mosdns=y
CONFIG_PACKAGE_v2ray-geodata=y
